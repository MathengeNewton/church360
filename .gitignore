# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies - ignore all node_modules everywhere
node_modules/
**/node_modules/
/frontend/node_modules
/welfare-frontend/node_modules
/backend/node_modules
/fronted/node_modules
/.pnp
/.pnp.*
/.yarn/*
!/.yarn/patches
!/.yarn/plugins
!/.yarn/releases
!/.yarn/versions

# testing
coverage/
**/coverage/

# next.js
.next/
**/.next/
/frontend/.next/
/frontend/out/
/welfare-frontend/.next/
!/welfare-frontend/out/  # Allow welfare-frontend/out/ to be committed
/fronted/.next/
/fronted/out/

# production
build/
**/build/
dist/
**/dist/

# misc
.DS_Store
*.pem
**/.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env*

# vercel
.vercel
**/.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
**/*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
